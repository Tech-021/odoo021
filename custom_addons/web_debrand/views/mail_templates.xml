<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_notification_layout_debrand" inherit_id="mail.mail_notification_layout">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="replace">
            <a target="_blank" href="https://www.tech-021.com"
               t-att-style="'color: ' + (company.email_secondary_color or '#009245') + ';'">Zero To One</a>
        </xpath>
    </template>

    <template id="mail_notification_light_debrand" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[contains(@href, 'www.odoo.com')]" position="replace">
            <a target="_blank" href="https://www.tech-021.com"
               t-att-style="'color: ' + (company.email_secondary_color or '#009245') + ';'">Zero To One</a>
        </xpath>
    </template>
</odoo>
