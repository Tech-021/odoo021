<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_notification_layout_debrand" inherit_id="mail.mail_notification_layout">
        <xpath expr="//div[@t-if='show_footer']" position="replace">
            <div t-if="show_footer" style="color: #555555; font-size:11px;">
                Powered by <a target="_blank" href="https://www.tech-021.com"
                              t-att-style="'color: ' + (company.email_secondary_color or '#009244') + ';'">Zero To One</a>
                <span t-if="show_unfollow" id="mail_unfollow">
                    | <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </div>
        </xpath>
    </template>

    <template id="mail_notification_light_debrand" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[contains(@href, 'www.odoo.com')]" position="replace">
            <a target="_blank" href="https://www.tech-021.com"
               t-att-style="'color: ' + (company.email_secondary_color or '#009244') + ';'">Zero To One</a>
        </xpath>
    </template>
</odoo>
