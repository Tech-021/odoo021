<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_slack_attendance_reminders" model="ir.cron">
            <field name="name">Attendance: Slack check-in and check-out reminders</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_slack_attendance_reminders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_config_reminder_check_in_enabled" model="ir.config_parameter">
            <field name="key">hr_attendance_slack.reminder_check_in_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="ir_config_reminder_check_in_hour" model="ir.config_parameter">
            <field name="key">hr_attendance_slack.reminder_check_in_hour</field>
            <field name="value">9.5</field>
        </record>
        <record id="ir_config_reminder_check_out_enabled" model="ir.config_parameter">
            <field name="key">hr_attendance_slack.reminder_check_out_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="ir_config_reminder_check_out_hour" model="ir.config_parameter">
            <field name="key">hr_attendance_slack.reminder_check_out_hour</field>
            <field name="value">18.5</field>
        </record>
    </data>
</odoo>
