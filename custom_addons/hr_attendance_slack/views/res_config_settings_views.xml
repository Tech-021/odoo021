<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance.slack</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Slack" name="slack_attendance_settings">
                    <setting string="HR Channel Notifications"
                             help="Post a message to Slack whenever an employee checks in or out. Use an Incoming Webhook created for the #hr channel.">
                        <field name="slack_attendance_enabled"/>
                        <div class="content-group" invisible="not slack_attendance_enabled">
                            <div class="row mt16">
                                <label for="slack_attendance_webhook_url" string="Incoming Webhook URL" class="col-lg-3 o_light_label"/>
                                <field name="slack_attendance_webhook_url"
                                       password="True"
                                       placeholder="https://hooks.slack.com/services/..."
                                       nolabel="1"/>
                            </div>
                            <div class="mt8">
                                <button name="action_test_slack_attendance"
                                        type="object"
                                        string="Send test message"
                                        class="btn-link"
                                        icon="fa-paper-plane"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Missing Check-in Reminder"
                             help="Each workday, post the employees who are scheduled to work but have not checked in. Skips weekends, public holidays, and time off."
                             invisible="not slack_attendance_enabled">
                        <field name="slack_reminder_check_in_enabled"/>
                        <div class="content-group" invisible="not slack_reminder_check_in_enabled">
                            <div class="row mt16">
                                <label for="slack_reminder_check_in_hour" string="Send at" class="col-lg-3 o_light_label"/>
                                <div>
                                    <field name="slack_reminder_check_in_hour" widget="float_time" class="oe_inline"/>
                                    <span class="text-muted ms-2">company timezone</span>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_send_slack_check_in_reminder"
                                        type="object"
                                        string="Send missing check-in list now"
                                        class="btn-link"
                                        icon="fa-bell"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Missing Check-out Reminder"
                             help="Each day, post the employees who are still checked in after this time."
                             invisible="not slack_attendance_enabled">
                        <field name="slack_reminder_check_out_enabled"/>
                        <div class="content-group" invisible="not slack_reminder_check_out_enabled">
                            <div class="row mt16">
                                <label for="slack_reminder_check_out_hour" string="Send at" class="col-lg-3 o_light_label"/>
                                <div>
                                    <field name="slack_reminder_check_out_hour" widget="float_time" class="oe_inline"/>
                                    <span class="text-muted ms-2">company timezone</span>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_send_slack_check_out_reminder"
                                        type="object"
                                        string="Send still-checked-in list now"
                                        class="btn-link"
                                        icon="fa-bell"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
