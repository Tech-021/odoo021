<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_bid_import_wizard_form" model="ir.ui.view">
        <field name="name">sales.bid.import.wizard.form</field>
        <field name="model">sales.bid.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Bids">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="data_file" filename="filename"/>
                </group>

                <group invisible="not result_message">
                    <field name="result_message" nolabel="1"/>
                </group>

                <footer>
                    <button name="action_download_template"
                            string="Download Template"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sales_bid_import_wizard" model="ir.actions.act_window">
        <field name="name">Upload Bids</field>
        <field name="res_model">sales.bid.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_sales_bid"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>